<?xml version="1.0" encoding="utf-8"?>
<MotionScene 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="1000">
       <KeyFrameSet>
       </KeyFrameSet>
        <OnSwipe
            motion:dragDirection="dragDown"
            motion:touchAnchorSide="bottom" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:layout_height="wrap_content"
            motion:layout_constraintGuide_percent="1"
            android:layout_width="wrap_content"
            android:id="@+id/guideline2" />
        <Constraint
            android:id="@+id/guideline4"
            motion:layout_constraintGuide_percent="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Constraint
            android:layout_height="wrap_content"
            motion:layout_constraintStart_toStartOf="@+id/toggleButton_camera"
            motion:layout_constraintTop_toTopOf="@+id/guideline2"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:id="@+id/seekBar_cameraZoom" />
        <Constraint
            android:id="@+id/constraintLayout2"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintTop_toBottomOf="@+id/mapView"
            motion:layout_constraintVertical_chainStyle="spread"
            motion:layout_constraintHorizontal_bias="0.5"
            motion:layout_constraintStart_toStartOf="parent"
            android:visibility="visible"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            motion:layout_constraintTop_toTopOf="@id/guideline2" />
        <Constraint
            android:id="@+id/constraintLayout3"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toTopOf="@+id/seekBar_cameraZoom"
            motion:layout_constraintHorizontal_bias="0.5"
            android:visibility="visible"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintTop_toBottomOf="@+id/mapView" />
        <Constraint
            android:layout_height="wrap_content"
            motion:layout_constraintGuide_percent="0.86"
            android:layout_width="wrap_content"
            android:id="@+id/guideline3" />
        <Constraint
            android:id="@+id/background"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toBottomOf="@+id/constraintLayout3"
            android:visibility="visible"
            motion:layout_constraintTop_toBottomOf="@+id/mapView"
            motion:layout_constraintStart_toStartOf="parent" />
    </ConstraintSet>
</MotionScene>